doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= typeof title === 'string' ? title + ' · Metas' : 'Metas'
    link(rel="stylesheet" href="/stylesheets/style.css")
    script(src="/javascripts/forms.js" defer)
  body
    header.site-header
      a.brand(href="/") Metas · Gestión local
      nav(aria-label="Navegación principal")
        a(href="/api/v1/products") Productos
        a(href="/api/v1/clients") Clientes
        a(href="/api/v1/clients/categorias") Categorías
    main
      block content
    footer Prototipo de aprendizaje con PostgreSQL. Uso local; no implementa sesiones ni autorización.

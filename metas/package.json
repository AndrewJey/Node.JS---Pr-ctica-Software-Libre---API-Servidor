{
  "name": "metas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env ./bin/www",
    "dev": "node --env-file-if-exists=.env --watch ./bin/www",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/sequelize-cli/lib/sequelize db:migrate",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.cjs",
    "db:demo": "node --env-file-if-exists=.env scripts/demo.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "express": "~5.3.0",
    "express-fileupload": "~1.6.0",
    "method-override": "^3.0.0",
    "morgan": "^1.10.1",
    "pg": "~8.23.1",
    "pug": "~3.0.4",
    "sequelize": "~6.37.8"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
